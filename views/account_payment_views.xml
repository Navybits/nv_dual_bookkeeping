<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         account.payment — Form view extension
         Adds O/NO toggle near the journal field, locked after posting.
         ================================================================ -->
    <record id="view_account_payment_form_dual_bookkeeping" model="ir.ui.view">
        <field name="name">account.payment.form.dual.bookkeeping</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">

            <!-- 1. Sync smart buttons in the stat-button box -->
            <xpath expr="//div[@name='button_box']" position="inside">

                <!-- Hidden fields needed for visibility logic -->
                <field name="sync_state" invisible="1"/>
                <field name="show_dual_bookkeeping_ui" invisible="1"/>
                <field name="company_is_official_company" invisible="1"/>
                <field name="company_official_company_id" invisible="1"/>
                <field name="is_mirror" invisible="1"/>

                <!-- Synced -->
                <button type="object" name="action_view_sync_logs"
                        class="oe_stat_button" icon="fa-check-circle text-success"
                        invisible="sync_state != 'synced' or not is_official or not show_dual_bookkeeping_ui">
                    <div class="o_stat_info">
                        <span class="o_stat_text text-success">Synced &#10003;</span>
                    </div>
                </button>

                <!-- Sync Error -->
                <button type="object" name="action_view_sync_logs"
                        class="oe_stat_button" icon="fa-exclamation-circle text-danger"
                        invisible="sync_state != 'error' or not is_official or not show_dual_bookkeeping_ui">
                    <div class="o_stat_info">
                        <span class="o_stat_text text-danger">Sync Error</span>
                    </div>
                </button>

                <!-- Not Synced -->
                <button type="object" name="action_view_sync_logs"
                        class="oe_stat_button" icon="fa-clock-o text-warning"
                        invisible="sync_state or not is_official or not show_dual_bookkeeping_ui">
                    <div class="o_stat_info">
                        <span class="o_stat_text text-warning">Not Synced</span>
                    </div>
                </button>

            </xpath>

            <!-- 2. Manual Sync button in the form header -->
            <xpath expr="//header" position="inside">
                <button name="action_manual_sync"
                        type="object"
                        string="&#8635; Sync to Official"
                        class="btn btn-secondary"
                        invisible="not is_official or is_mirror or state not in ('in_process', 'paid') or sync_state == 'synced' or not company_official_company_id"
                        groups="nv_dual_bookkeeping.group_sync_manager"/>
                <button name="action_change_to_non_official"
                        type="object"
                        string="Change to Non-Official"
                        class="btn btn-secondary"
                        invisible="not is_official or is_mirror or state not in ('in_process', 'paid') or company_is_official_company"
                        groups="account.group_account_manager"/>
            </xpath>

            <!-- 3. O/NO toggle — inserted after the journal_id field -->
            <xpath expr="//field[@name='journal_id']" position="after">

                <!-- Own label row so the group keeps label/value pairs aligned
                     (a bare div shifted every field below it by one cell). -->
                <label for="is_official" string="Official"/>
                <div class="o_dual_bookkeeping_badge d-flex align-items-center gap-2">

                    <!-- Official badge -->
                    <span class="badge text-bg-success fs-6"
                          invisible="not is_official">
                        &#10003; Official
                    </span>

                    <!-- Non-Official badge -->
                    <span class="badge text-bg-warning fs-6"
                          invisible="is_official">
                        &#9888; Non-Official
                    </span>

                    <!-- Editable toggle: only in draft state -->
                    <field name="is_official"
                           widget="boolean_toggle"
                           nolabel="1"
                           readonly="state != 'draft'"/>

                    <!-- Track explicit set (hidden) -->
                    <field name="is_official_set" invisible="1"/>

                </div>

            </xpath>

        </field>
    </record>

