<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         account.journal — Form view extension
         Adds a "Dual Bookkeeping" notebook page with sequence stat buttons.
         ================================================================ -->
    <record id="view_account_journal_form_dual_bookkeeping" model="ir.ui.view">
        <field name="name">account.journal.form.dual.bookkeeping</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">

            <!-- Dual Bookkeeping notebook page -->
            <xpath expr="//notebook" position="inside">
                <page string="Dual Bookkeeping" name="dual_bookkeeping">

                    <group string="Official Journal Mapping">
                        <group>
                            <field name="journal_official_company_id" invisible="1"/>
                            <field name="official_journal_id"
                                   domain="[('company_id', '=', journal_official_company_id)]"
                                   options="{'no_create': True}"
                                   help="Select the corresponding journal in the official company. Its Official sequence will be the master counter shared across all companies."/>
                        </group>
                    </group>

                    <field name="use_numeric_sequence"/>

                    <group string="Sequences" col="2" invisible="use_numeric_sequence">
                        <group string="Official (O)">
                            <field name="seq_prefix_o" placeholder="e.g. BANK-O"/>
                            <field name="seq_preview_o" readonly="1"/>
                        </group>
                        <group string="Non-Official (NO)">
                            <field name="seq_prefix_no" placeholder="e.g. BANK-NO"/>
                            <field name="seq_preview_no" readonly="1"/>
                        </group>
                    </group>

                    <group string="Numeric Sequence (CODE/FYY/NNNNNN)" invisible="not use_numeric_sequence">
                        <field name="numeric_seq_continue_from_year" placeholder="e.g. 2026"/>
                    </group>
                    <group col="2" invisible="not use_numeric_sequence">
                        <group string="Official (O)">
                            <field name="numeric_seq_continue_from_o"/>
                            <field name="numeric_seq_preview_o" readonly="1"/>
                        </group>
                        <group string="Non-Official (NO)">
                            <field name="numeric_seq_continue_from_no"/>
                            <field name="numeric_seq_preview_no" readonly="1"/>
                        </group>
                    </group>

                    <div class="alert alert-info" role="alert"
                         invisible="official_journal_id">
                        <strong>No Official Journal mapped.</strong>
                        Official transactions in this journal will use the local sequence
                        as a fallback. Use
                        <em>Accounting &gt; Dual Bookkeeping &gt; Link Official Journals</em>
                        to configure the mapping.
                    </div>

                </page>
            </xpath>

        </field>
    </record>

</odoo>
