<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_nv_mirror_partner_fix_wizard_form" model="ir.ui.view">
        <field name="name">nv.mirror.partner.fix.wizard.form</field>
        <field name="model">nv.mirror.partner.fix.wizard</field>
        <field name="arch" type="xml">
            <form string="Fix Mirror Partners">
                <div class="alert alert-info" role="alert">
                    Gives each mirror in the Official Books company exactly the
                    contacts of its original document (document, journal items,
                    payment). Nothing is reset to draft and reconciliations are
                    kept. Mirrors in a locked period or already secured (hashed)
                    cannot be changed and are listed as <em>Cannot Fix</em>.
                </div>
                <field name="searched" invisible="1"/>
                <group invisible="not searched">
                    <field name="company_id" options="{'no_open': True}"/>
                    <field name="to_fix_count" string="To fix"/>
                    <field name="error_count" string="Cannot fix"/>
                </group>
                <field name="line_ids" nolabel="1" invisible="not searched">
                    <list decoration-success="state == 'fixed'"
                          decoration-danger="state == 'error'">
                        <field name="source_move_id"/>
                        <field name="mirror_move_id"/>
                        <field name="current_partner_id"/>
                        <field name="correct_partner_id"/>
                        <field name="line_count"/>
                        <field name="payment_to_fix"/>
                        <field name="state"/>
                        <field name="message"/>
                    </list>
                </field>
                <footer>
                    <button name="action_find" type="object" string="Find Mirrors to Fix"
                            class="btn-primary" invisible="searched"/>
                    <button name="action_fix" type="object" string="Fix"
                            class="btn-primary" invisible="not to_fix_count"
                            confirm="Change the partners of the listed mirrors?"/>
                    <button name="action_find" type="object" string="Search Again"
                            class="btn-secondary" invisible="not searched"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_nv_mirror_partner_fix_wizard" model="ir.actions.act_window">
        <field name="name">Fix Mirror Partners</field>
        <field name="res_model">nv.mirror.partner.fix.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
